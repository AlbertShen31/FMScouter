    {
      "id": "box_threat",
      "label": "Box Threat",
      "icon": "game-icons:punch-blast",
      "groups": ["def"],
      "metrics": ["goals", "expected_goals", "shots"]
    },
    {
      "id": "presser",
      "label": "Presser",
      "icon": "game-icons:sprint",
      "groups": ["mid", "fwd"],
      "metrics": ["pressures"],
      "metrics_fallback": ["possession_won", "tackles_attempted"],
      "note": "Uses pressures when present in the active threshold pack for the group; otherwise possession_won + tackles_attempted."
