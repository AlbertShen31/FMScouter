# Local loopback (auth optional when host is 127.0.0.1 / localhost)
FM_HOST=127.0.0.1
FM_PORT=8050
FM_DEBUG=false

# Either set credentials:
FM_AUTH_USER=changeme
FM_AUTH_PASSWORD=changeme
# Or disable auth for loopback-only local use:
# FM_AUTH_DISABLED=true

# Optional; generated ephemerally if unset (set a fixed value in deploy)
# FM_SECRET_KEY=

# --- Render / public deploy ---
# FM_HOST=0.0.0.0
# Auth credentials are required when not on loopback.
# PORT is set by Render; bind_port() also reads it.
# Do not set FM_AUTH_DISABLED=true on a public host.
# Prefer not uploading Moneyball / squad finance CSVs to a public demo disk.
